{
  "name": "payroll-and-attendance-system",
  "version": "1.0.0",
  "description": "Full-Stack Payroll and Attendance Management System",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "start": "node start.js",
    "server": "npm run dev --workspace=server",
    "client": "npm run dev --workspace=client",
    "seed": "npm run seed --workspace=server",
    "build": "cd client && npm run build",
    "build:client": "cd client && npm run build"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.3.1",
    "pdfkit": "^0.16.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "payroll",
    "attendance",
    "hr-management"
  ],
  "author": "",
  "license": "ISC"
}
